@page
@model Qablny.Areas.Admin.Pages.Moderation.BlacklistModel
@{
    ViewData["Title"] = "الكلمات المحظورة";
    var success = TempData["SuccessMessage"] as string;
    var error = TempData["ErrorMessage"] as string;
}

<div class="bx--row">
    <div class="bx--col-lg-12">
        <h1 class="bx--type-productive-heading-05" style="margin-bottom: 2rem;">الكلمات المحظورة (Blacklist)</h1>
        <p class="bx--type-body-short-01" style="margin-bottom: 2rem;">إضافة كلمات مسيئة ليقوم النظام بحجبها تلقائياً من الدردشة النصية.</p>
        
        @if (!string.IsNullOrEmpty(success))
        {
            <div class="bx--inline-notification bx--inline-notification--success" style="margin-bottom:1rem;">
                <p><strong>@success</strong></p>
            </div>
        }
        @if (!string.IsNullOrEmpty(error))
        {
            <div class="bx--inline-notification bx--inline-notification--error" style="margin-bottom:1rem;">
                <p><strong>@error</strong></p>
            </div>
        }
    </div>
</div>

<div class="bx--row">
    <div class="bx--col-md-6">
        <form method="post" asp-page-handler="Add" style="display: flex; gap: 1rem; margin-bottom: 2rem;">
            <div class="bx--form-item" style="flex: 1;">
                <input type="text" class="bx--text-input" name="NewWord" placeholder="أدخل كلمة جديدة للحظر..." required>
            </div>
            <button class="bx--btn bx--btn--primary" type="submit">إضافة ➕</button>
        </form>

        <ul class="bx--list--unordered">
            @if(!Model.Words.Any()) {
                <li class="bx--list__item" style="color: #525252;">لا توجد كلمات محظورة حالياً.</li>
            }
            @foreach(var word in Model.Words)
            {
                <li class="bx--list__item" style="margin-bottom: 0.5rem; display: flex; justify-content: space-between; align-items: center; padding: 0.5rem; background: #161616; border: 1px solid #393939;">
                    <span style="font-weight: bold;">@word</span>
                    <form method="post" asp-page-handler="Remove" style="margin: 0;">
                        <input type="hidden" name="word" value="@word" />
                        <button type="submit" class="bx--btn bx--btn--sm bx--btn--danger--ghost" style="padding: 0 0.5rem;" onclick="return confirm('هل أنت متأكد من حذف هذه الكلمة؟');">حذف</button>
                    </form>
                </li>
            }
        </ul>
    </div>
</div>
