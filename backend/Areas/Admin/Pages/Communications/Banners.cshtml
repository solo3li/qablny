@page
@model Qablny.Areas.Admin.Pages.Communications.BannersModel
@{
    ViewData["Title"] = "البنرات الإعلانية";
    var success = TempData["SuccessMessage"] as string;
    var error = TempData["ErrorMessage"] as string;
}

<div class="bx--row">
    <div class="bx--col-lg-12">
        <h1 class="bx--type-productive-heading-05" style="margin-bottom: 2rem;">إدارة البنرات الإعلانية</h1>
        <p class="bx--type-body-short-01" style="margin-bottom: 2rem;">إضافة وإدارة البنرات التي تظهر في الواجهة الرئيسية للمستخدمين.</p>
        
        @if (!string.IsNullOrEmpty(success))
        {
            <div class="bx--inline-notification bx--inline-notification--success" style="margin-bottom:1rem;">
                <p><strong>@success</strong></p>
            </div>
        }
        @if (!string.IsNullOrEmpty(error))
        {
            <div class="bx--inline-notification bx--inline-notification--error" style="margin-bottom:1rem;">
                <p><strong>@error</strong></p>
            </div>
        }
    </div>
</div>

<div class="bx--row" style="margin-bottom: 2rem;">
    <div class="bx--col-md-8">
        <div class="bx--tile">
            <h4 class="bx--type-productive-heading-02" style="margin-bottom: 1rem;">إضافة بنر جديد</h4>
            <form method="post" asp-page-handler="Add" enctype="multipart/form-data" style="display: flex; gap: 1rem; align-items: flex-end;">
                <div class="bx--form-item">
                    <label class="bx--label">صورة البنر</label>
                    <input type="file" name="ImageFile" accept="image/png, image/jpeg, image/webp" required style="padding: 0.5rem 0;" />
                </div>
                <div class="bx--form-item">
                    <label class="bx--label">رابط (اختياري)</label>
                    <input type="url" class="bx--text-input" name="LinkUrl" placeholder="https://..." />
                </div>
                <button class="bx--btn bx--btn--primary" type="submit">رفع البنر</button>
            </form>
        </div>
    </div>
</div>

<div class="bx--row">
    <div class="bx--col-lg-12">
        <table class="bx--data-table">
            <thead>
                <tr>
                    <th><span class="bx--table-header-label">الصورة</span></th>
                    <th><span class="bx--table-header-label">الرابط المرفق (Link)</span></th>
                    <th><span class="bx--table-header-label">الحالة</span></th>
                    <th><span class="bx--table-header-label">تاريخ الإنشاء</span></th>
                    <th><span class="bx--table-header-label">إجراءات</span></th>
                </tr>
            </thead>
            <tbody>
                @if(!Model.Banners.Any()) {
                    <tr><td colspan="5" style="text-align: center;">لا يوجد بنرات حالياً.</td></tr>
                }
                @foreach(var banner in Model.Banners)
                {
                    <tr>
                        <td><img src="@banner.ImageUrl" alt="Banner" style="height: 40px; border-radius: 4px;" /></td>
                        <td>@(string.IsNullOrEmpty(banner.LinkUrl) ? "لا يوجد" : banner.LinkUrl)</td>
                        <td>
                            @if(banner.IsActive) {
                                <span style="color: #24a148; font-weight:bold;">نشط</span>
                            } else {
                                <span style="color: #da1e28;">متوقف</span>
                            }
                        </td>
                        <td>@banner.CreatedAt.ToString("yyyy-MM-dd")</td>
                        <td>
                            <form method="post" asp-page-handler="Toggle" style="margin: 0;">
                                <input type="hidden" name="id" value="@banner.Id" />
                                <button type="submit" class="bx--btn bx--btn--sm @(banner.IsActive ? "bx--btn--danger--ghost" : "bx--btn--ghost")">
                                    @(banner.IsActive ? "إيقاف" : "تفعيل")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
