@page
@model Qablny.Areas.Admin.Pages.Finance.VIPModel
@{
    ViewData["Title"] = "اشتراكات الـ VIP";
    var success = TempData["SuccessMessage"] as string;
    var error = TempData["ErrorMessage"] as string;
}

<div class="bx--row">
    <div class="bx--col-lg-12">
        <h1 class="bx--type-productive-heading-05" style="margin-bottom: 2rem;">إدارة اشتراكات الـ VIP</h1>
        <p class="bx--type-body-short-01" style="margin-bottom: 2rem;">إدارة الباقات، تعديل الأسعار، ومتابعة الاشتراكات النشطة.</p>
        
        @if (!string.IsNullOrEmpty(success))
        {
            <div class="bx--inline-notification bx--inline-notification--success" style="margin-bottom:1rem;">
                <p><strong>@success</strong></p>
            </div>
        }
        @if (!string.IsNullOrEmpty(error))
        {
            <div class="bx--inline-notification bx--inline-notification--error" style="margin-bottom:1rem;">
                <p><strong>@error</strong></p>
            </div>
        }
    </div>
</div>

<div class="bx--row" style="margin-bottom: 2rem;">
    <div class="bx--col-md-12">
        <div class="bx--tile">
            <h4 class="bx--type-productive-heading-02" style="margin-bottom: 1rem;">إضافة باقة جديدة</h4>
            <form method="post" asp-page-handler="Add" style="display: flex; gap: 1rem; align-items: flex-end; flex-wrap: wrap;">
                <div class="bx--form-item">
                    <label class="bx--label">الاسم</label>
                    <input type="text" class="bx--text-input" name="Name" placeholder="مثال: ذهبي" required>
                </div>
                <div class="bx--form-item">
                    <label class="bx--label">المدة</label>
                    <div class="bx--select">
                        <select class="bx--select-input" name="PeriodString" required>
                            <option value="Weekly">أسبوعي</option>
                            <option value="Monthly" selected>شهري</option>
                            <option value="Yearly">سنوي</option>
                        </select>
                        <svg focusable="false" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg" fill="currentColor" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" class="bx--select__arrow"><path d="M8 11L3 6 3.7 5.3 8 9.6 12.3 5.3 13 6z"></path></svg>
                    </div>
                </div>
                <div class="bx--form-item">
                    <label class="bx--label">السعر ($)</label>
                    <input type="number" class="bx--text-input" name="Price" min="0" step="0.01" placeholder="9.99" required>
                </div>
                <div class="bx--form-item">
                    <label class="bx--label">بونص عملات</label>
                    <input type="number" class="bx--text-input" name="BonusCoins" min="0" value="0">
                </div>
                <div class="bx--form-item" style="margin-bottom: 0.5rem;">
                    <div class="bx--checkbox-wrapper">
                        <input id="isbest" class="bx--checkbox" type="checkbox" value="true" name="IsBest">
                        <label for="isbest" class="bx--checkbox-label">باقة مميزة ⭐</label>
                    </div>
                </div>
                <button class="bx--btn bx--btn--primary" type="submit">إضافة</button>
            </form>
        </div>
    </div>
</div>

<div class="bx--row">
    <div class="bx--col-lg-12">
        <table class="bx--data-table">
            <thead>
                <tr>
                    <th><span class="bx--table-header-label">اسم الباقة</span></th>
                    <th><span class="bx--table-header-label">المدة</span></th>
                    <th><span class="bx--table-header-label">السعر</span></th>
                    <th><span class="bx--table-header-label">بونص عملات</span></th>
                    <th><span class="bx--table-header-label">الحالة</span></th>
                    <th><span class="bx--table-header-label">إجراءات</span></th>
                </tr>
            </thead>
            <tbody>
                @if(!Model.Plans.Any()) {
                    <tr><td colspan="6" style="text-align: center;">لا توجد باقات مسجلة.</td></tr>
                }
                @foreach(var plan in Model.Plans)
                {
                    <tr>
                        <td>@plan.Name @(plan.IsBest ? "⭐" : "")</td>
                        <td>@plan.Period</td>
                        <td>$@plan.Price</td>
                        <td>@plan.BonusCoins</td>
                        <td>
                            @if(plan.IsActive) {
                                <span style="color: #24a148; font-weight:bold;">نشط</span>
                            } else {
                                <span style="color: #da1e28;">متوقف</span>
                            }
                        </td>
                        <td>
                            <form method="post" asp-page-handler="Toggle" style="margin: 0;">
                                <input type="hidden" name="id" value="@plan.Id" />
                                <button type="submit" class="bx--btn bx--btn--sm @(plan.IsActive ? "bx--btn--danger--ghost" : "bx--btn--ghost")">
                                    @(plan.IsActive ? "إيقاف" : "تفعيل")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
