@page
@model Qablny.Areas.Admin.Pages.Finance.StoreModel
@{
    ViewData["Title"] = "متجر الهدايا";
    var success = TempData["SuccessMessage"] as string;
    var error = TempData["ErrorMessage"] as string;
}

<div class="bx--row">
    <div class="bx--col-lg-12">
        <h1 class="bx--type-productive-heading-05" style="margin-bottom: 2rem;">إدارة الهدايا (Gift Store)</h1>
        <p class="bx--type-body-short-01" style="margin-bottom: 2rem;">رفع الهدايا، تسعيرها، وإدارتها.</p>
        
        @if (!string.IsNullOrEmpty(success))
        {
            <div class="bx--inline-notification bx--inline-notification--success" style="margin-bottom:1rem;">
                <p><strong>@success</strong></p>
            </div>
        }
        @if (!string.IsNullOrEmpty(error))
        {
            <div class="bx--inline-notification bx--inline-notification--error" style="margin-bottom:1rem;">
                <p><strong>@error</strong></p>
            </div>
        }
    </div>
</div>

<div class="bx--row" style="margin-bottom: 2rem;">
    <div class="bx--col-md-8">
        <div class="bx--tile">
            <h4 class="bx--type-productive-heading-02" style="margin-bottom: 1rem;">إضافة هدية جديدة</h4>
            <form method="post" asp-page-handler="Add" style="display: flex; gap: 1rem; align-items: flex-end;">
                <div class="bx--form-item">
                    <label class="bx--label">اسم الهدية</label>
                    <input type="text" class="bx--text-input" name="Name" placeholder="مثال: وردة" required>
                </div>
                <div class="bx--form-item">
                    <label class="bx--label">الإيموجي</label>
                    <input type="text" class="bx--text-input" name="Emoji" placeholder="مثال: 🌹" required>
                </div>
                <div class="bx--form-item">
                    <label class="bx--label">التكلفة (عملات)</label>
                    <input type="number" class="bx--text-input" name="CoinCost" min="1" placeholder="مثال: 10" required>
                </div>
                <button class="bx--btn bx--btn--primary" type="submit">إضافة</button>
            </form>
        </div>
    </div>
</div>

<div class="bx--row">
    <div class="bx--col-lg-12">
        <table class="bx--data-table">
            <thead>
                <tr>
                    <th><span class="bx--table-header-label">الهدية</span></th>
                    <th><span class="bx--table-header-label">الاسم</span></th>
                    <th><span class="bx--table-header-label">التكلفة (عملات)</span></th>
                    <th><span class="bx--table-header-label">الحالة</span></th>
                    <th><span class="bx--table-header-label">إجراءات</span></th>
                </tr>
            </thead>
            <tbody>
                @if(!Model.Gifts.Any()) {
                    <tr><td colspan="5" style="text-align: center;">لا توجد هدايا مسجلة.</td></tr>
                }
                @foreach(var gift in Model.Gifts)
                {
                    <tr>
                        <td style="font-size: 1.5rem;">@gift.Emoji</td>
                        <td>@gift.Name</td>
                        <td>@gift.CoinCost</td>
                        <td>
                            @if(gift.IsActive) {
                                <span style="color: #24a148; font-weight:bold;">نشط</span>
                            } else {
                                <span style="color: #da1e28;">متوقف</span>
                            }
                        </td>
                        <td>
                            <form method="post" asp-page-handler="Toggle" style="margin: 0;">
                                <input type="hidden" name="id" value="@gift.Id" />
                                <button type="submit" class="bx--btn bx--btn--sm @(gift.IsActive ? "bx--btn--danger--ghost" : "bx--btn--ghost")">
                                    @(gift.IsActive ? "إيقاف" : "تفعيل")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
